# Copie para config.env (o instalar.sh já faz isso) e ajuste.

# sombra = não envia nada, só escreve em sombra/AAAA-MM-DD.md o que mandaria
# ao_vivo = responde de verdade
MODO=sombra

# claude (Claude Code) ou codex (ChatGPT / Codex CLI)
MOTOR=claude
# vazio = padrão (claude usa sonnet). Ex.: MODELO=haiku para ficar mais barato
MODELO=

# Teste ao vivo com segurança: a IA só responde estes números (com DDI, vírgula entre eles)
SO_ESTES=
# A IA nunca responde estes (família, fornecedor, sócio...)
NUNCA_ESTES=
# Número que recebe o aviso quando a IA passa a conversa para humano (com DDI, ex.: 5521999999999)
AVISAR_DONO=

# sempre | fora_expediente (a IA só atende quando a equipe não está)
HORARIO=sempre
EXPEDIENTE_INICIO=09:00
EXPEDIENTE_FIM=18:00
EXPEDIENTE_DIAS=1,2,3,4,5

# Espera X minutos de silêncio antes de responder (cliente que manda 3 mensagens seguidas)
ESPERA_MIN=1
# Mensagem mais velha que isso não é respondida (evita responder fila antiga ao ligar)
IDADE_MAX_H=6
# Alguém da equipe respondeu à mão? A IA fica quieta naquela conversa por X horas
TRAVA_HUMANO_H=12

BRIDGE_URL=http://localhost:8080
